<Window x:Class="Pizarra.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Pizarra.App"
        Title="Pizarra Workflows" Icon="/Pizarra.App;component/Assets/pizarra-workflows.ico" Width="1280" Height="800" MinWidth="900" MinHeight="600"
        Background="#0B1020" Foreground="#E8EDF7" WindowStartupLocation="CenterScreen">
    <!-- Before the content: StaticResource only finds resources already defined above it. -->
    <Window.Resources>
        <Style TargetType="Button"><Setter Property="Background" Value="#1B2540"/><Setter Property="Foreground" Value="#E8EDF7"/><Setter Property="BorderBrush" Value="#344263"/><Setter Property="Padding" Value="10,7"/><Setter Property="Margin" Value="2"/><Setter Property="FontSize" Value="12"/><Setter Property="Cursor" Value="Hand"/></Style>
        <Style TargetType="ListBoxItem"><Setter Property="Padding" Value="9"/><Setter Property="Margin" Value="2"/><Setter Property="Background" Value="#11182A"/></Style>
        <Style x:Key="ToolGroup" TargetType="Border"><Setter Property="Background" Value="#0E1526"/><Setter Property="CornerRadius" Value="8"/><Setter Property="Padding" Value="4,2"/><Setter Property="Margin" Value="4,3"/></Style>
        <Style x:Key="GroupLabel" TargetType="TextBlock"><Setter Property="Foreground" Value="#65718A"/><Setter Property="FontSize" Value="9"/><Setter Property="FontWeight" Value="Bold"/><Setter Property="VerticalAlignment" Value="Center"/><Setter Property="Margin" Value="6,0,4,0"/></Style>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions><RowDefinition x:Name="HeaderRow" Height="Auto"/><RowDefinition/></Grid.RowDefinitions>
        <Border x:Name="TopBar" Background="#11182A" BorderBrush="#25304A" BorderThickness="0,0,0,1" Padding="14,6">
            <DockPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" DockPanel.Dock="Left" Margin="0,0,14,0">
                    <Image Source="/Pizarra.App;component/Assets/pizarra-workflows.ico" Width="32" Height="32" Margin="0,0,11,0"/>
                    <StackPanel VerticalAlignment="Center"><TextBlock Text="PIZARRA WORKFLOWS" FontWeight="Bold" FontSize="15"/><TextBlock Text="Ideas, sistemas y procesos en un solo lugar" Foreground="#8792AA" FontSize="11"/></StackPanel>
                </StackPanel>
                <WrapPanel HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Border Style="{StaticResource ToolGroup}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="LÁPIZ" Style="{StaticResource GroupLabel}"/>
                            <Button x:Name="DrawToolButton" Content="✎ Dibujar" Click="Draw_Click" ToolTip="Escribir y dibujar con el lápiz"/>
                            <Button x:Name="EraseToolButton" Content="⌫ Goma" Click="Erase_Click" ToolTip="Pasa el lápiz sobre un trazo para borrarlo"/>
                            <Button x:Name="SelectToolButton" Content="↖ Mover" Click="Select_Click" ToolTip="Seleccionar y mover bloques"/>
                            <Button x:Name="ConnectToolButton" Content="→ Flecha" Click="Connect_Click" ToolTip="Toca un bloque y luego otro para unirlos con una flecha"/>
                            <Button x:Name="PanToolButton" Content="✋ Mano" Click="Pan_Click" ToolTip="Arrastra con el lápiz para subir, bajar o moverte por el lienzo (también: mantener Espacio, o la rueda del ratón)"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource ToolGroup}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="VISTA" Style="{StaticResource GroupLabel}"/>
                            <Button Content="−" Click="ZoomOut_Click" ToolTip="Alejar (Ctrl + rueda)" MinWidth="30"/>
                            <Button Content="＋" Click="ZoomIn_Click" ToolTip="Acercar (Ctrl + rueda)" MinWidth="30"/>
                            <Button Content="⌂ Inicio" Click="ResetView_Click" ToolTip="Volver al principio del tablero al 100 %"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource ToolGroup}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="DIAGRAMA" Style="{StaticResource GroupLabel}"/>
                            <Button Content="⬭ Inicio/Fin" Click="AddTerminal_Click" ToolTip="Inicio o fin del flujo"/>
                            <Button Content="▭ Proceso" Click="AddProcess_Click" ToolTip="Un paso o actividad"/>
                            <Button Content="◇ Decisión" Click="AddDecision_Click" ToolTip="Una pregunta con dos salidas (sí / no)"/>
                            <Button Content="▱ Entrada/Salida" Click="AddInputOutput_Click" ToolTip="Datos que entran o salen"/>
                            <Button Content="＋ Nota" Click="AddNote_Click" ToolTip="Nota adhesiva para escribir a mano"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource ToolGroup}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="EDITAR" Style="{StaticResource GroupLabel}"/>
                            <Button Content="↶ Deshacer" Click="Undo_Click" ToolTip="Deshacer la última acción (Ctrl+Z)"/>
                            <Button Content="↷ Rehacer" Click="Redo_Click" ToolTip="Rehacer (Ctrl+Y)"/>
                            <Button Content="Aa Texto" Click="Edit_Click" ToolTip="Cambiar el texto del bloque seleccionado"/>
                            <Button Content="🗑 Quitar bloque" Click="Delete_Click" ToolTip="Quitar el bloque seleccionado y sus flechas (Supr)"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource ToolGroup}">
                        <StackPanel Orientation="Horizontal">
                            <Button x:Name="LinkWacomButton" Content="Vincular Wacom" Click="LinkWacom_Click"/>
                            <Button Content="Diagnóstico" Click="Diagnostics_Click"/>
                            <Button Content="⛶" Click="Fullscreen_Click" ToolTip="Pantalla completa"/>
                            <Button Content="PNG" Click="ExportPng_Click" ToolTip="Exportar como imagen"/>
                            <Button Content="PDF" Click="ExportPdf_Click" ToolTip="Exportar como PDF"/>
                        </StackPanel>
                    </Border>
                </WrapPanel>
            </DockPanel>
        </Border>
        <Grid x:Name="WorkspaceGrid" Grid.Row="1">
            <Grid.ColumnDefinitions><ColumnDefinition Width="250"/><ColumnDefinition/></Grid.ColumnDefinitions>
            <Border x:Name="LibraryPane" Background="#101729" BorderBrush="#25304A" BorderThickness="0,0,1,0" Padding="14">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <StackPanel>
                        <TextBlock Text="TU BIBLIOTECA" Foreground="#8792AA" FontSize="11" FontWeight="Bold" Margin="4,5,0,12"/>
                        <Button Content="＋ Nuevo proyecto" Click="NewFolder_Click" HorizontalContentAlignment="Left"/>
                        <Button Content="＋ Nuevo tablero" Click="NewBoard_Click" HorizontalContentAlignment="Left"/>
                    </StackPanel>
                    <ListBox x:Name="BoardList" Grid.Row="1" Margin="0,14,0,0" Background="Transparent" BorderThickness="0" Foreground="#E8EDF7" SelectionChanged="BoardList_SelectionChanged"/>
                    <Border x:Name="ItemPanel" Grid.Row="2" Background="#141D33" BorderBrush="#2B3756" BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,10,0,0" Visibility="Collapsed">
                        <StackPanel>
                            <TextBlock x:Name="ItemKindText" Text="TABLERO" Foreground="#8792AA" FontSize="10" FontWeight="Bold" Margin="2,0,0,6"/>
                            <TextBox x:Name="RenameBox" Padding="6" Background="#0E1526" Foreground="#E8EDF7" BorderBrush="#344263" CaretBrush="#E8EDF7" KeyDown="RenameBox_KeyDown"/>
                            <UniformGrid Columns="2" Margin="0,6,0,0">
                                <Button Content="Renombrar" Click="Rename_Click"/>
                                <Button x:Name="DeleteItemButton" Content="🗑 Eliminar" Click="DeleteItem_Click" Background="#3A1E2A" BorderBrush="#6B3346"/>
                            </UniformGrid>
                        </StackPanel>
                    </Border>
                    <TextBlock Grid.Row="3" Text="Guardado local · Documentos\Wacom Workboard · lo eliminado va a la Papelera" TextWrapping="Wrap" Foreground="#65718A" FontSize="10" Margin="4,10,4,0"/>
                </Grid>
            </Border>
            <Grid x:Name="BoardHost" Grid.Column="1" Background="#0B1020">
                <local:BoardSurface x:Name="Board" Margin="18"/>
                <Border HorizontalAlignment="Left" VerticalAlignment="Top" Margin="30" Background="#D911182A" CornerRadius="8" Padding="12,8" IsHitTestVisible="False">
                    <TextBlock x:Name="BoardTitle" Text="Abre un tablero o crea uno nuevo" FontSize="12" Foreground="#AFB9CC"/>
                </Border>
                <TextBlock x:Name="StatusText" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,255,25" Foreground="#77839B" FontSize="11" Text="Listo" IsHitTestVisible="False"/>
                <TextBlock x:Name="WacomStatusText" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,28,25" Foreground="#9AA8C4" FontSize="11" Text="Buscando controlador Wacom…" IsHitTestVisible="False"/>
            </Grid>
        </Grid>
        <!-- Text editor inside the window: a separate dialog window would take activation and release the pen. -->
        <Grid x:Name="InlinePrompt" Grid.RowSpan="2" Background="#B3060A14" Visibility="Collapsed">
            <Border Width="420" HorizontalAlignment="Center" VerticalAlignment="Center" Background="#141D33" BorderBrush="#344263" BorderThickness="1" CornerRadius="10" Padding="18">
                <StackPanel>
                    <TextBlock x:Name="InlinePromptTitle" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,10"/>
                    <TextBox x:Name="InlinePromptBox" Padding="8" FontSize="14" Background="#0E1526" Foreground="#E8EDF7" BorderBrush="#344263" CaretBrush="#E8EDF7" KeyDown="InlinePromptBox_KeyDown"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                        <Button Content="Aceptar" Click="InlinePromptOk_Click" Background="#2D3F78"/>
                        <Button Content="Cancelar" Click="InlinePromptCancel_Click"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
