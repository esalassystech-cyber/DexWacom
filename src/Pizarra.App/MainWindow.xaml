<Window x:Class="Pizarra.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Pizarra.App"
        Title="Pizarra Workflows" Icon="/Pizarra.App;component/Assets/pizarra-workflows.ico" Width="1280" Height="800" MinWidth="900" MinHeight="600"
        Background="#0B1020" Foreground="#E8EDF7" WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.RowDefinitions><RowDefinition x:Name="HeaderRow" Height="64"/><RowDefinition/></Grid.RowDefinitions>
        <Border x:Name="TopBar" Background="#11182A" BorderBrush="#25304A" BorderThickness="0,0,0,1">
            <DockPanel Margin="18,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" DockPanel.Dock="Left">
                    <Image Source="/Pizarra.App;component/Assets/pizarra-workflows.ico" Width="32" Height="32" Margin="0,0,11,0"/>
                    <StackPanel><TextBlock Text="PIZARRA WORKFLOWS" FontWeight="Bold" FontSize="15"/><TextBlock Text="Ideas, sistemas y procesos en un solo lugar" Foreground="#8792AA" FontSize="11"/></StackPanel>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Content="＋ Nota" Click="AddNote_Click"/><Button Content="▭ Proceso" Click="AddProcess_Click"/><Button Content="◇ Decisión" Click="AddDecision_Click"/><Button x:Name="ConnectToolButton" Content="↗ Conectar" Click="Connect_Click"/><Button Content="Editar" Click="Edit_Click"/><Button Content="Borrar" Click="Delete_Click"/>
                    <Separator Margin="8,0"/><Button x:Name="SelectToolButton" Content="↖ Seleccionar" Click="Select_Click"/><Button x:Name="DrawToolButton" Content="✎ Dibujar" Click="Draw_Click"/>
                    <Button x:Name="LinkWacomButton" Content="Vincular Wacom" Click="LinkWacom_Click"/><Button Content="Diagnóstico" Click="Diagnostics_Click"/><Button Content="⛶ Pantalla completa" Click="Fullscreen_Click"/><Button Content="Exportar PNG" Click="ExportPng_Click"/><Button Content="Exportar PDF" Click="ExportPdf_Click"/>
                </StackPanel>
            </DockPanel>
        </Border>
        <Grid x:Name="WorkspaceGrid" Grid.Row="1">
            <Grid.ColumnDefinitions><ColumnDefinition Width="250"/><ColumnDefinition/></Grid.ColumnDefinitions>
            <Border x:Name="LibraryPane" Background="#101729" BorderBrush="#25304A" BorderThickness="0,0,1,0" Padding="14">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top">
                        <TextBlock Text="TU BIBLIOTECA" Foreground="#8792AA" FontSize="11" FontWeight="Bold" Margin="4,5,0,12"/>
                        <Button Content="＋ Nuevo proyecto" Click="NewFolder_Click" HorizontalContentAlignment="Left"/>
                        <Button Content="＋ Nuevo tablero" Click="NewBoard_Click" HorizontalContentAlignment="Left"/>
                    </StackPanel>
                    <ListBox x:Name="BoardList" Margin="0,14,0,0" Background="Transparent" BorderThickness="0" Foreground="#E8EDF7" SelectionChanged="BoardList_SelectionChanged"/>
                    <TextBlock DockPanel.Dock="Bottom" Text="Guardado local · Documentos\Wacom Workboard" TextWrapping="Wrap" Foreground="#65718A" FontSize="10" Margin="4,10,4,0"/>
                </DockPanel>
            </Border>
            <Grid x:Name="BoardHost" Grid.Column="1" Background="#0B1020">
                <local:BoardSurface x:Name="Board" Margin="18"/>
                <Border HorizontalAlignment="Left" VerticalAlignment="Top" Margin="30" Background="#D911182A" CornerRadius="8" Padding="12,8" IsHitTestVisible="False">
                    <TextBlock x:Name="BoardTitle" Text="Abre un tablero o crea uno nuevo" FontSize="12" Foreground="#AFB9CC"/>
                </Border>
                <TextBlock x:Name="StatusText" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,255,25" Foreground="#77839B" FontSize="11" Text="Listo" IsHitTestVisible="False"/>
                <TextBlock x:Name="WacomStatusText" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,28,25" Foreground="#9AA8C4" FontSize="11" Text="Buscando controlador Wacom…" IsHitTestVisible="False"/>
            </Grid>
        </Grid>
    </Grid>
    <Window.Resources>
        <Style TargetType="Button"><Setter Property="Background" Value="#1B2540"/><Setter Property="Foreground" Value="#E8EDF7"/><Setter Property="BorderBrush" Value="#344263"/><Setter Property="Padding" Value="12,8"/><Setter Property="Margin" Value="3"/><Setter Property="FontSize" Value="12"/><Setter Property="Cursor" Value="Hand"/></Style>
        <Style TargetType="ListBoxItem"><Setter Property="Padding" Value="9"/><Setter Property="Margin" Value="2"/><Setter Property="Background" Value="#11182A"/></Style>
    </Window.Resources>
</Window>
